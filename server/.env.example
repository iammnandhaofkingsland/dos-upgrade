# Copy to .env for local work. Never commit .env.
# --- model access: choose ONE of the two blocks ---
# A) Gemini API key from Google AI Studio (simplest; used for the buildathon demo)
GOOGLE_API_KEY=paste-your-key-here
# B) Gemini through Google Cloud (Gemini Enterprise Agent Platform) with your gcloud identity
# GOOGLE_GENAI_USE_VERTEXAI=1
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global

# --- platform ---
DQ_MODEL_MODE=live            # live | mock (mock = scripted offline model for rehearsal and tests)
DQ_STORE=memory               # memory | firestore
DQ_TENANT=demo                # default client (header mode only)
DQ_AUTH_MODE=token            # token = real sign-in with signed sessions (always use this). headers = tests and scripts only
DQ_SESSION_SECRET=            # long random string that signs session tokens. Empty = a new random one each start (everyone signs in again)
DQ_DEMO_LOGINS=1              # 1 = show reviewer quick-access cards and the demo password on the sign-in page. 0 for real clients
DQ_DEMO_PASSWORD=DOS@2026     # password of every demo user
DQ_PLANT_LOOP=1               # 1 = run the live plant simulator and the automatic downtime response
DQ_API_KEY=                   # shared secret for header mode only
DQ_MODEL_FLASH=gemini-3.8-flash
DQ_MODEL_LITE=gemini-3.5-flash-lite
DQ_MODEL_PRO=gemini-4-argon
DQ_MODEL_IMAGE=gemini-nano-banana-2.1
DQ_USD_INR=88
# Step budgets, the evaluation pass mark and every other limit are CLIENT settings now (layer 2):
# see server/dq/clients.py and the Client configuration screen.
